# Copia este archivo como .env (NO lo subas a git)
# Expo inyecta automáticamente cualquier variable con prefijo EXPO_PUBLIC_
# IMPORTANTE: no uses localhost, tu celular/emulador no lo puede resolver.
# Usa la IP de tu máquina en la red local o la URL pública del backend desplegado.

EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
